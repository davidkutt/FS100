# FS100 — local development environment.
# Copy to `.env` (git-ignored) and adjust. Every value here is a DEV-ONLY placeholder;
# never put a real secret into this file. `pnpm dev` and `pnpm stack:*` read `.env`, then `.env.local`
# (also git-ignored; real secrets such as the GitHub PATs go there and win over `.env`).
# Empty values get their comment on the line above: Compose reads `KEY=   # note` as the value "# note".

# --- infra ---
# Applied ONLY on the first start, when the Docker volumes are created. Later edits need
# `pnpm stack:reset` (wipes all local data) — see docs/setup/startup.md §7.
# KEYCLOAK_ADMIN* is the Keycloak server admin (http://localhost:8080/admin), not an app user.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me

# --- api (NestJS) ---
API_PORT=3000
LOG_LEVEL=info                              # pino: fatal|error|warn|info|debug|trace|silent
# must repeat POSTGRES_USER / POSTGRES_PASSWORD
API_DATABASE_URL=postgresql://postgres:dev-only-change-me@localhost:5432/app
KEYCLOAK_ISSUER=http://localhost:8080/realms/kb
# KEYCLOAK_REALM_URL=                       # how the API reaches the realm; unset = KEYCLOAK_ISSUER (Mode B: keycloak:8080)
KEYCLOAK_AUDIENCE=kb-api
KEYCLOAK_CLIENT_ID=kb-api
KEYCLOAK_CLIENT_SECRET=dev-only-change-me   # must match realm-kb.json, imported on the first start only (pnpm stack:reset)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_AUDIENCE=kb-ai                   # hop 1: user tokens are exchanged for this audience (ADR-0009)
INGEST_URL_ALLOWED_HOSTS=raw.githubusercontent.com  # kb.ingest_url fetches only from these (host[:port], comma-separated)
CORS_ORIGINS=http://localhost:4200
UPLOAD_MAX_MB=20
CHAT_THROTTLE_PER_MIN=20
DAILY_COST_CAP_USD_VIEWER=0.20             # LLM cost per user and UTC day by highest role (D44); then 429
DAILY_COST_CAP_USD_EDITOR=1.00
DAILY_COST_CAP_USD_ADMIN=5.00
# TAXONOMY_CONFIG=                          # unset = config/taxonomy.yaml in the repo; the images set their own path

# --- ai-service (FastAPI) ---
AI_PORT=8000
AI_KEYCLOAK_ISSUER=http://localhost:8080/realms/kb
AI_KEYCLOAK_AUDIENCE=kb-ai
# AI_KEYCLOAK_REALM_URL=                    # same for the AI service's JWKS fetch and token exchange
AI_KEYCLOAK_CLIENT_ID=kb-ai
AI_KEYCLOAK_CLIENT_SECRET=dev-only-change-me  # must match realm-kb.json, imported on the first start only (pnpm stack:reset)
MCP_RESOURCE_URL=http://localhost:8000/mcp  # own MCP server = hop-2 audience; must match realm-kb.json (first start only)
AI_API_URL=http://localhost:3000            # the API, for kb.ingest_url (/internal/documents/from-url)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ALIAS=kb_current
# Stored originals + job queue (D52, D53); the AI service creates the database on boot. Must repeat
# POSTGRES_USER / POSTGRES_PASSWORD.
AI_DATABASE_URL=postgresql://postgres:dev-only-change-me@localhost:5432/ai
JOBS_INPROCESS_WORKER=true                  # the worker runs inside the AI service (false from P4)
# GOLDEN_DATASET=                           # unset = ../../evals/datasets/retrieval_v1.jsonl, the re-index gate (D55)
EMBEDDING_MODEL=BAAI/bge-m3                 # ADR-0004
EMBEDDING_CACHE_DIR=./.cache/fastembed
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SPARSE_MODEL=bm25-english                   # ADR-0016: none | bm25-english | bm25-neutral; then pnpm kb:reindex
# ADR-0017: off (none). Opt-in on restart, no re-index, but set the threshold with it:
# jinaai/jina-reranker-v2-base-multilingual-int8 (CC BY-NC 4.0, non-commercial) → 0.35,
# cross-encoder/mmarco-mMiniLMv2-L12-H384-v1-int8 (Apache-2.0) → 0.40.
RERANKER_MODEL=none
RERANK_CANDIDATES=10                        # fused hits the reranker scores; jina: p95 1.5 s on the M1 (D57)
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.55              # ADR-0004 calibration, model-specific (0.35 with jina, above)
LLM_PROVIDER=openai_compat                  # openai_compat | fake
LLM_BASE_URL=https://openrouter.ai/api/v1   # HF alternative: https://router.huggingface.co/v1
# OpenRouter key WITH a credit limit; required unless fake
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna                 # required unless fake; demo: deepseek/deepseek-v4.1-flash (ADR-0005)
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_S=60
# MODELS_CONFIG=                            # unset = ../../config/models.yaml (the model picker); TAXONOMY_CONFIG likewise
AGENT_MAX_STEPS=8                           # agent limits (ADR-0007); each ends the run with a stopReason
AGENT_MAX_PARALLEL_TOOLS=4                  # read tools only
AGENT_TOOL_TIMEOUT_S=20
AGENT_RUN_TIMEOUT_S=120
AGENT_RUN_INPUT_TOKEN_BUDGET=60000
AGENT_RUN_COST_CAP_USD=0.05
APPROVAL_SIGNING_KEY=dev-only-change-me-approval-signing-key  # HMAC for write approvals (ADR-0008), ≥ 32 chars; rotate: new,old
APPROVAL_TTL_MIN=15                         # time to decide on a proposed write
ROUTER=embedding                            # domain routing (D33): embedding (no tokens) | llm
# cheap model for ROUTER=llm; empty = LLM_MODEL
ROUTER_MODEL=
WEB_FETCH_ALLOWED_HOSTS=docs.github.com,kubernetes.io  # the only hosts web.fetch reads; empty = no web.fetch
# MCP_SERVERS_CONFIG=                       # unset = ../../config/mcp_servers.yaml (external MCP servers, D38)
GITHUB_MCP_URL=http://localhost:8082/mcp    # the github-mcp container (pnpm stack:up); Mode B sets github-mcp:8082
# owner/repo the github.* tools read, e.g. davidkutt/FS100
GITHUB_REPO=
# owner/repo of github_sandbox.create_issue; empty = write unavailable
GITHUB_SANDBOX_REPO=
# Put the PATs into .env.local (D37), never here: fine-grained, expiring, one repo each.
# GITHUB_PAT_READ: read-only (contents, issues, actions, metadata) on GITHUB_REPO.
# GITHUB_PAT_SANDBOX_WRITE: Issues read/write on GITHUB_SANDBOX_REPO only.
GITHUB_PAT_READ=
GITHUB_PAT_SANDBOX_WRITE=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-service

# --- web (rendered into config.json in the container) ---
WEB_KEYCLOAK_URL=http://localhost:8080
WEB_KEYCLOAK_REALM=kb
WEB_KEYCLOAK_CLIENT_ID=kb-web
WEB_API_BASE_URL=http://localhost:3000
WEB_PHOENIX_URL=http://localhost:6006       # dev-mode trace links; empty = hidden
