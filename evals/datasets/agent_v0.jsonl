{"id": "a-001", "lang": "en", "domains": ["devops"], "type": "kb-lookup", "prompt": "What's the command to roll the api deployment back to revision 41?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-rollback.md", "heading": "Rollback on Kubernetes"}], "answer_regex": ["--to-revision=41"], "max_steps": 3, "answer_status": "answered"}}
{"id": "a-002", "lang": "en", "domains": ["sre"], "type": "kb-lookup", "prompt": "During a SEV2, who writes the status updates and how often do they go out?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-incident-response.md", "heading": "Roles"}, {"doc": "runbook-incident-response.md", "heading": "Severity levels"}], "answer_regex": ["(?i)communications lead", "60 minutes"], "max_steps": 3, "answer_status": "answered"}}
{"id": "a-003", "lang": "en", "domains": ["security"], "type": "kb-lookup", "prompt": "How often do we rotate the OpenRouter API key?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-secret-rotation.md", "heading": "Rotation schedule"}], "answer_regex": ["90 days"], "max_steps": 3, "answer_status": "answered"}}
{"id": "a-004", "lang": "en", "domains": ["ai", "mlops"], "type": "kb-lookup", "prompt": "After swapping the embedding model, how long do we keep the old Qdrant collection?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-embedding-model-swap.md", "heading": "Roll back"}], "answer_regex": ["(?i)seven days|7 days"], "max_steps": 3, "answer_status": "answered"}}
{"id": "a-005", "lang": "en", "domains": ["sre"], "type": "kb-lookup", "prompt": "What availability target does chat have, and over which window is it measured?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "slo-handbook.pdf", "page": 2}], "answer_regex": ["99\\.5", "28"], "max_steps": 3, "answer_status": "answered"}}
{"id": "a-006", "lang": "en", "domains": ["architecture"], "type": "kb-lookup", "prompt": "Why does the AI code live in a separate Python service instead of the NestJS API?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "adr-0002-ai-layer-in-python.md"}], "answer_regex": ["(?i)python"], "max_steps": 3, "answer_status": "answered"}}
{"id": "a-007", "lang": "en", "domains": ["devops", "db"], "type": "multi-hop", "prompt": "This morning's API release is broken and it contained a database migration. Can we still roll back, and what must happen before anyone touches the schema?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-rollback.md", "heading": "Database migrations"}, {"doc": "runbook-postgres-backup-restore.md", "heading": "Take a manual backup"}], "answer_regex": ["(?i)expand", "(?i)backup"], "max_steps": 4, "answer_status": "answered"}, "notes": "rollback runbook + Postgres backup runbook"}
{"id": "a-008", "lang": "en", "domains": ["ai", "sre"], "type": "multi-hop", "prompt": "The LLM provider has been returning 5xx errors to users for 20 minutes. Which incident severity is that, and what do we do first?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-llm-provider-outage.md", "heading": "Afterwards"}, {"doc": "runbook-llm-provider-outage.md", "heading": "Triage by status code"}, {"doc": "runbook-incident-response.md", "heading": "First 15 minutes"}], "answer_regex": ["SEV2", "(?i)switch"], "max_steps": 4, "answer_status": "answered"}, "notes": "provider runbook (severity, switch) + incident runbook (mitigate first)"}
{"id": "a-009", "lang": "en", "domains": ["security", "sre"], "type": "multi-hop", "prompt": "Someone pasted the kb-api client secret into a public chat. What do we do right now, and by when is the postmortem due?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-secret-rotation.md", "heading": "Leaked secret"}, {"doc": "runbook-incident-response.md", "heading": "Postmortem"}], "answer_regex": ["(?i)revoke", "(?i)five business days|5 business days"], "max_steps": 4, "answer_status": "answered"}, "notes": "leak → SEV2 postmortem (rotation runbook) → deadline (incident runbook)"}
{"id": "a-010", "lang": "en", "domains": ["ai", "mlops", "architecture"], "type": "multi-hop", "prompt": "We want to swap the embedding model. What must the benchmark show first, and where are embeddings computed according to our ADR?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-embedding-model-swap.md", "heading": "Before you switch"}, {"doc": "adr-0003-embeddings-in-process.md", "heading": "Decision"}], "answer_regex": ["(?i)ndcg", "(?i)in-process|inside the AI service|fastembed"], "max_steps": 4, "answer_status": "answered"}}
{"id": "a-011", "lang": "en", "domains": ["sre"], "type": "multi-hop", "prompt": "A single SEV3 incident used up a quarter of the chat error budget. Do we need a postmortem, and how soon?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "slo-handbook.pdf", "page": 2}, {"doc": "runbook-incident-response.md", "heading": "Postmortem"}], "answer_regex": ["(?i)yes|required|20", "(?i)five business days|5 business days"], "max_steps": 4, "answer_status": "answered"}, "notes": "SLO handbook (>20 % → postmortem even for SEV3) + incident runbook (deadline)"}
{"id": "a-012", "lang": "de", "domains": ["devops"], "type": "cross-language", "prompt": "Wie setze ich ein Deployment auf Kubernetes auf die vorherige Version zurück?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-rollback.md", "heading": "Rollback on Kubernetes"}], "answer_regex": ["rollout undo", "(?i)\\b(und|der|die|das|mit)\\b"], "max_steps": 3, "answer_status": "answered"}, "notes": "DE question, EN document, answer in German"}
{"id": "a-013", "lang": "en", "domains": ["security", "devops"], "type": "cross-language", "prompt": "Our cert-manager renewal failed. After fixing the cause, how do I trigger the renewal again?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "runbook-tls-zertifikat-erneuern.md", "heading": "Automatische Erneuerung mit cert-manager reparieren"}], "answer_regex": ["cmctl renew", "(?i)\\b(the|and|then)\\b"], "max_steps": 3, "answer_status": "answered"}, "notes": "EN question, DE document, answer in English"}
{"id": "a-014", "lang": "de", "domains": ["sre"], "type": "cross-language", "prompt": "Wie lange darf der Chat in 28 Tagen komplett ausfallen, bevor das Fehlerbudget aufgebraucht ist?", "expect": {"tools_required": ["kb.search_knowledge_base"], "cites_any": [{"doc": "slo-handbook.pdf", "page": 2}], "answer_regex": ["(?s)\\b3\\b.{0,25}\\b22\\b", "(?i)stunden"], "max_steps": 3, "answer_status": "answered"}, "notes": "DE question, EN PDF (3 h 22 min)"}
