    "/api/documents": {
      "get": {
        "operationId": "DocumentsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Document"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Documents"
        ]
      },
      "post": {
        "operationId": "DocumentsController_upload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "domains": {
                    "anyOf": [
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "db",
                            "dev",
                            "cloud",
                            "devops",
                            "mlops",
                            "ai",
                            "security",
                            "architecture",
                            "sre"
                          ]
                        }
                      },
                      {
                        "type": "string",
                        "enum": [
                          "db",
                          "dev",
                          "cloud",
                          "devops",
                          "mlops",
                          "ai",
                          "security",
                          "architecture",
                          "sre"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "file",
                  "domains"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Documents"
        ]
      }
    },
    "/api/documents/{id}": {
      "delete": {
        "operationId": "DocumentsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "tags": [
          "Documents"
        ]
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "ChatController_chat",
        "parameters": [],
        "responses": {
          "200": {
            "description": "SSE: `SourcesEvent`, `TokenEvent`…, `DoneEvent` or `ErrorEvent`"
          }
        },
        "tags": [
          "Chat"
        ]
