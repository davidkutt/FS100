  "info": {
    "title": "FS100 API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "viewer",
                "editor",
                "admin"
              ]
            }
          }
        },
        "required": [
          "sub",
          "name",
          "roles"
        ],
        "additionalProperties": false
      },
      "StatusReport": {
        "type": "object",
        "properties": {
          "api": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "aiService": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "qdrant": {
            "type": "string",
            "enum": [
              "ok",
              "down",
              "unknown"
            ]
          }
        },
        "required": [
          "api",
          "db",
          "aiService",
          "qdrant"
        ],
        "additionalProperties": false
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "ownerId": {
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "db",
                "dev",
                "cloud",
                "devops",
                "mlops",
                "ai",
                "security",
                "architecture",
                "sre"
              ]
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "queued",
              "parsing",
              "contextualizing",
              "embedding",
              "ready",
              "failed"
            ]
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "active",
              "retired"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "canonical",
              "normal",
              "low"
            ]
          },
          "priorityTopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "jobId": {
            "nullable": true,
            "type": "string"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "chunkCount": {
            "nullable": true,
            "type": "integer",
            "minimum": -9007199254740991,
