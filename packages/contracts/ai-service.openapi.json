      "ErrorEvent": {
        "properties": {
          "type": {
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "detail"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "Source": {
        "properties": {
          "n": {
            "title": "N",
            "type": "integer"
          },
          "docId": {
            "format": "uuid",
            "title": "Docid",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "domains": {
            "items": {
              "enum": [
                "db",
                "dev",
                "cloud",
                "devops",
                "mlops",
                "ai",
                "security",
                "architecture",
                "sre"
              ],
              "type": "string"
            },
            "title": "Domains",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "n",
          "docId",
          "title",
          "page",
          "heading",
          "domains",
          "text",
          "score"
        ],
        "title": "Source",
        "type": "object"
